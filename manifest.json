{
  "manifest_version": 3,
  "name": "Elyon Amazon Importer",
  "version": "1.2.10",
  "description": "Eigenständiger Amazon Standalone Importer mit automatischem Listing Designer, eBay-Kategoriesuche, echten Seller-Hub-Entwürfen und Elyon-Beschreibungsdesigns.",
  "action": {
    "default_title": "Elyon Amazon Importer",
    "default_popup": "popup-fixed.html"
  },
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.amazon.de/*",
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://elyonsellertool.vercel.app/*",
    "https://elyon-company-os.vercel.app/*",
    "https://elyon-seller-tool.vercel.app/*"
  ]
}
